# Copy to .env (or run `npm run bootstrap`, which generates secrets for you). Never commit .env.

# --- HTTP ---
HOST=0.0.0.0
PORT=8080
WEB_DIST=./apps/web/dist
# Set true only when running behind a TLS-terminating reverse proxy you control (enables Secure cookies + HSTS).
BEHIND_TLS_PROXY=false
# Hops of trusted proxy in front of the API (affects client IP for rate limiting). 0 = none.
TRUSTED_PROXY_HOPS=0

# --- Persistence ---
DATABASE_PATH=./data/dockside.sqlite

# --- Secrets (generate with `npm run bootstrap`; each must be >= 32 chars) ---
# Encrypts notification-channel secrets at rest (AES-256-GCM).
SECRETS_KEY=
# Needed once, to create the first admin account. Remove after setup if you like.
SETUP_TOKEN=

# --- Collection ---
SCRAPE_INTERVAL_SECONDS=15
RAW_RETENTION_DAYS=3
ROLLUP_RETENTION_DAYS=90
# Optional: registers one host when the host list is empty (compose sets this to the bundled node_exporter).
BOOTSTRAP_HOST_NAME=
BOOTSTRAP_HOST_URL=

# --- Docker (talk to a read-only socket proxy, never the raw socket) ---
DOCKER_ENDPOINT=
# Linux Compose: `stat -c '%g' /var/run/docker.sock` gives the socket group ID.
DOCKER_GID=0
DOCKER_PROXY_ALLOW_RESTART=0
# Adjust for a custom Docker bridge; never bind the exporter to a public interface.
NODE_EXPORTER_BIND_ADDRESS=172.17.0.1
DOCKSIDE_DOMAIN=localhost
# Container restart actions are OFF unless this is true AND the proxy allows POST /restart.
CONTAINER_ACTIONS_ENABLED=false
LOG_TAIL_MAX=500

# --- Sample data (development / screenshots only; hosts and containers are labelled "Sample data" in the UI) ---
SAMPLE_DATA=false
